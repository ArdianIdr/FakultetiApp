@model FakultetiApp.Models.Student
@{ ViewData["Title"] = "Student i ri"; }
<h2>Student i ri</h2>
<form asp-action="Krijo" method="post" enctype="multipart/form-data" style="max-width:480px">
    <div class="mb-3"><label asp-for="Emri" class="form-label"></label><input asp-for="Emri" class="form-control" /><span asp-validation-for="Emri" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Mbiemri" class="form-label"></label><input asp-for="Mbiemri" class="form-control" /><span asp-validation-for="Mbiemri" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Viti" class="form-label"></label><input asp-for="Viti" class="form-control" /><span asp-validation-for="Viti" class="text-danger"></span></div>
    <div class="mb-3"><label class="form-label">Dokument / foto (ruhet në Blob Storage)</label><input type="file" name="dokumenti" class="form-control" /></div>
    <button class="btn btn-success">Ruaj</button> <a class="btn btn-secondary" asp-action="Index">Anulo</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
