        <a class="btn btn-primary" asp-controller="Studentet" asp-action="Index">Hap</a></div></div></div>
    <div class="col-md-6"><div class="card h-100"><div class="card-body">
        <h5>Njoftimet</h5><p>Njoftimet ruhen në <b>Azure PostgreSQL</b>.</p>
